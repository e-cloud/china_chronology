{
  "name": "china-chronology",
  "version": "0.1.0",
  "description": "中国历代纪年、公历年份与天干地支双向互转库（基于哈佛/中研院/北大 CBDB 数据库）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "require": "./dist/data/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "extract": "python ../scripts/extract_cbdb.py",
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "keywords": [
    "chronology",
    "china",
    "dynasty",
    "nianhao",
    "cbdb",
    "ganzhi",
    "gregorian",
    "chinese-history"
  ],
  "author": "e-cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-cloud/china_chronology.git"
  },
  "bugs": {
    "url": "https://github.com/e-cloud/china_chronology/issues"
  },
  "homepage": "https://github.com/e-cloud/china_chronology#readme",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  }
}
